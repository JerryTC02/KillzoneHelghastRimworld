                    <layer>21</layer>
                </dataSouth>
                <dataWest>
				    <layer>21</layer>
                </dataWest>
                <dataEast>
				    <layer>21</layer>
                </dataEast>
                <dataNorth>
                </dataNorth>
            </drawData>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Shoulders</li>
        <li>Arms</li>
      </bodyPartGroups>
	  <tags>
        <li>HelghastAssault</li>
      </tags>
      <wornGraphicPath>Things/Helghast/Rifleman/RiflemanBandolier</wornGraphicPath>
      <layers>
        <li>Belt</li>
      </layers>
    </apparel>
	<modExtensions>
     <li Class="taranchuk_apparelgraphics.ApparelExtension">
      <hideBody>False</hideBody>
      <femaleBody>Male</femaleBody>
      <maleBody>Male</maleBody>
     </li>
    </modExtensions>
  </ThingDef>

</Defs>