<?xml version="1.0" encoding="utf-8" ?>

<Defs>

  <WorkGiverDef>
    <defName>DoBillsHGfoundry</defName>
    <label>fabricate things</label>
    <giverClass>WorkGiver_DoBill</giverClass>
    <workType>Smithing</workType>
    <priorityInType>50</priorityInType>
    <fixedBillGiverDefs>
      <li>HG_Foundry</li>
    </fixedBillGiverDefs>
    <verb>fabricate</verb>
    <gerund>fabricating things at</gerund>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
    <prioritizeSustains>true</prioritizeSustains>
  </WorkGiverDef>

  <ThingDef ParentName="BenchBase">
    <defName>HG_Foundry</defName>
    <label>Helghan Foundry</label>
    <description>Helghan armories tend to be rapidly depleted by overuse. Even during the war on Helghan , units needed to make use of looted small arms to supplement their own stockpiles. Now that the empire is shattered into successor states, this problem has only grown. On-site manufacturing was the answer, but due to increasingly bickering and hostile Mega-corporations, it became difficult for the various factions and worlds of the Helghan diaspora to retain any sort of consistency. Fortunately, one megacorporation provided a convenient answer. Lysk-Corp, or HLC Heavy Concern,  provides local factions contracts to access a data-vault of schematics for a nominal fee. This has become a profitable venture largely due to grateful donations by powerful successor states, who buy through HLC to avoid heavy tariffs or corporate exclusivity clauses. The other corporations tolerate HLC because they provide a portion of profit back to the original corporation that designed the schematic - and because they too have become reliant on HLC's data to supplement their own largely scattered knowledge. Not much is known about this mysterious new power player- except that they clearly wish to further the interests of Helghan conquest across the rim.\n\nThis workbench is the core of a local HLC-supported manufactory; silently billing the workers using it indefinitely as new schematics are downloaded and made ready by way of a well hidden network of commsat arrays. The facility itself is of good quality, intended to plug in organically with workshop and factory complexes, making this the heart of any burgeoning supply depot or armory.\n\nDEV-NOTE - check the gun itself for the full descriptions, basegame has an issue with long descriptions on buildings. will try to fix later</description>
    <thingClass>Building_WorkTable</thingClass>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <statBases>
      <MaxHitPoints>500</MaxHitPoints>
      <WorkToBuild>6500</WorkToBuild>
      <Flammability>0.1</Flammability>
    </statBases>
    <minifiedDef />
    <thingCategories Inherit="false" />
    <size>(5,2)</size>
    <costList>
      <Steel>225</Steel>
      <ComponentIndustrial>13</ComponentIndustrial>
    </costList>
    <comps>
      <li Class="CompProperties_AffectedByFacilities">
        <linkableFacilities>
          <li>ToolCabinet</li>
        </linkableFacilities>
      </li>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>500</basePowerConsumption>
        <shortCircuitInRain>true</shortCircuitInRain>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_Breakdownable"/>
    </comps>
    <recipes>
      <li>Make_ComponentIndustrial_Helghancopy</li>
      <li>Make_ComponentSpacer</li>
    </recipes>
    <graphicData>
      <texPath>Things/Helghast/Structures/Prodbench/HelghastFactoryBench</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(7,4)</drawSize>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <castEdgeShadows>true</castEdgeShadows>
    <staticSunShadowHeight>0.20</staticSunShadowHeight>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
    <building>
      <spawnedConceptLearnOpportunity>BillsTab</spawnedConceptLearnOpportunity>
    </building>
    <fillPercent>0.5</fillPercent>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <hasInteractionCell>true</hasInteractionCell>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <designationCategory>Production</designationCategory>
    <uiOrder>1000020</uiOrder>
    <surfaceType>Item</surfaceType>
    <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
    <placeWorkers>
      <li>PlaceWorker_ShowFacilitiesConnections</li>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
    <researchPrerequisites>
      <li>Machining</li>
    </researchPrerequisites>
  </ThingDef>
  
  <RecipeDef>
    <defName>Make_ComponentIndustrial_Helghancopy</defName>
    <label>make component</label>
    <description>Make a component.</description>
    <jobString>Making component.</jobString>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_Machining</soundWorking>
    <workAmount>5000</workAmount>
    <unfinishedThingDef>UnfinishedComponent</unfinishedThingDef>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Steel</li>
          </thingDefs>
        </filter>
        <count>12</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Steel</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <ComponentIndustrial>1</ComponentIndustrial>
    </products>
	<researchPrerequisite>Fabrication</researchPrerequisite>
    <skillRequirements>
      <Crafting>8</Crafting>
    </skillRequirements>
    <workSkill>Crafting</workSkill>
    <displayPriority>0</displayPriority>
  </RecipeDef>

</Defs>
