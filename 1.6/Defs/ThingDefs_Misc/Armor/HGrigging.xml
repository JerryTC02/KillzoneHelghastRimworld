<?xml version="1.0" encoding="utf-8" ?>

<Defs>

  <ThingDef ParentName="HelghastArmorMachineableBase">
    <defName>Apparel_HG_Assaultweb</defName>
    <label>Helghast Assault Webbing</label>
    <description>A plethora of pouches allow for assault units to have an easy time reloading weapons, keeping spare grenades handy, and carrying supplies. Often times, troops will keep spare ammo drums for their rifles on their backs in place of a backpack thanks to their pouches. The 'heavy gut' profile this webbing gives an infantryman partially explains the oft ascribed 'Hig' nickname the helghan armed forces is saddled with- a  portmaneau of 'Helghast Pig' - perhaps for their heavyset gait. All the positives of this webbing do come with drawbacks, its somewhat heavy, despite boosting a troopers carry capacity, and it impedes movement. A small price to pay considering its other advantages.</description>
    <techLevel>Industrial</techLevel>
    <recipeMaker>
      <unfinishedThingDef>UnfinishedMetallicTechArmor</unfinishedThingDef>
      <researchPrerequisite>FlakArmor</researchPrerequisite>
      <skillRequirements>
        <Crafting>4</Crafting>
      </skillRequirements>
      <recipeUsers Inherit="False">
        <li>HG_Foundry</li>
      </recipeUsers>
	  <displayPriority>301</displayPriority>
    </recipeMaker>
    <graphicData>
      <texPath>Things/Helghast/Assault/AssaultBandolier_south</texPath>
      <graphicClass>Graphic_Single</graphicClass>
	  <drawSize>1.1</drawSize>
    </graphicData>
    <statBases>
      <WorkToMake>2250</WorkToMake>
      <MaxHitPoints>115</MaxHitPoints>
      <Mass>2</Mass>
      <Flammability>0.25</Flammability>
      <ArmorRating_Sharp>0.1</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.1</ArmorRating_Blunt>
      <ArmorRating_Heat>0</ArmorRating_Heat>
      <Insulation_Cold>3</Insulation_Cold>
      <Insulation_Heat>1</Insulation_Heat>
      <EquipDelay>1.5</EquipDelay>
    </statBases>
    <equippedStatOffsets>
      <RangedCooldownFactor>-0.1</RangedCooldownFactor>
	  <VEF_MassCarryCapacity MayRequire="OskarPotocki.VanillaFactionsExpanded.Core">35</VEF_MassCarryCapacity>
	  <MoveSpeed>-0.05</MoveSpeed>
    </equippedStatOffsets>
    <thingCategories>
      <li>ApparelUtility</li>
    </thingCategories>
    <costList>
	  <Steel>25</Steel>
	  <Cloth>90</Cloth>
    </costList>
    <apparel>
			<drawData>
                <dataSouth>
                    <layer>21.5</layer>
                </dataSouth>
                <dataWest>
				    <layer>21.5</layer>
                </dataWest>
                <dataEast>
				    <layer>21.5</layer>
                </dataEast>
                <dataNorth>
			        <layer>21.5</layer>
                </dataNorth>
            </drawData>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Shoulders</li>
        <li>Arms</li>
      </bodyPartGroups>
	  <tags>
        <li>HelghastAssault</li>
      </tags>
      <wornGraphicPath>Things/Helghast/Assault/AssaultBandolier</wornGraphicPath>
      <layers>
        <li>Belt</li>
      </layers>
    </apparel>
	<modExtensions>
     <li Class="taranchuk_apparelgraphics.ApparelExtension">
      <hideBody>False</hideBody>
      <femaleBody>Male</femaleBody>
      <maleBody>Male</maleBody>
     </li>
    </modExtensions>
  </ThingDef>
  
