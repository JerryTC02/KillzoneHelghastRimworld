	  <MoveSpeed>-0.50</MoveSpeed>
	  <ToxicEnvironmentResistance>1</ToxicEnvironmentResistance>
	  <FixBrokenDownBuildingSuccessChance>-0.25</FixBrokenDownBuildingSuccessChance>
