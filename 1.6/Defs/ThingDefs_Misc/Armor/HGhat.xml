	  <drawSize>1</drawSize>
    </graphicData>
    <uiIconScale>1.25</uiIconScale>
    <statBases>
      <WorkToMake>2150</WorkToMake>
      <MaxHitPoints>105</MaxHitPoints>
      <Mass>0.5</Mass>
      <Flammability>0.5</Flammability>
