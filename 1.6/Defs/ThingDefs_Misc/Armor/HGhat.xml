      <wornGraphicPath>Things/Helghast/ShockTrooper/Capfancy/kz1_officer_cap</wornGraphicPath>
	  <renderSkipFlags>
        <li>None</li>
      </renderSkipFlags>
      <layers>
        <li>Overhead</li>
