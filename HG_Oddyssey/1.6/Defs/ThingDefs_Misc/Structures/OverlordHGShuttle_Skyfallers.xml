<?xml version="1.0" encoding="utf-8"?>

<Defs>

  <ThingDef ParentName="ShuttleSkyfallerBase">
    <defName>OverlordShuttleIncoming</defName>
    <label>Overlord Dropship (incoming)</label>
    <thingClass>PassengerShuttleIncoming</thingClass>
    <graphicData>
      <graphicClass>Graphic_Multi</graphicClass>
      <texPath>Things/Building/Overlord_Dropship/Overlord</texPath>
      <shaderType>CutoutComplex</shaderType>
			<drawSize>(5.5,9)</drawSize>
    </graphicData>
    <skyfaller>
      <anticipationSound>Shuttle_Landing</anticipationSound>
      <anticipationSoundTicks>250</anticipationSoundTicks>
      <ticksToImpactRange>200~250</ticksToImpactRange>
      <shadowSize>(4.5,6.5)</shadowSize>
      <rotationCurve>
        <points>
          <li>(0,30)</li>
          <li>(0.5,5)</li>
          <li>(0.9,-5)</li>
          <li>(0.95,0)</li>
        </points>
      </rotationCurve>
      <zPositionCurve>
        <points>
          <li>(0.95,2.5)</li>
          <li>(1,0)</li>
        </points>
      </zPositionCurve>
      <speedCurve>
        <points>
          <li>(0.6,0.6)</li>
          <li>(0.95,0.94)</li>
        </points>
      </speedCurve>
    </skyfaller>
  </ThingDef>

  <ThingDef ParentName="ShuttleSkyfallerBase">
    <defName>OverlordShuttleLeaving</defName>
    <label>Overlord Dropship (leaving)</label>
    <thingClass>PassengerShuttleLeaving</thingClass>
    <rotatable>true</rotatable>
    <graphicData>
      <graphicClass>Graphic_Multi</graphicClass>
      <texPath>Things/Building/Overlord_Dropship/Overlord</texPath>
      <shaderType>CutoutComplex</shaderType>
			<drawSize>(5.5,9)</drawSize>
    </graphicData>
    <skyfaller>
      <reversed>true</reversed>
      <anticipationSound>Shuttle_Leaving</anticipationSound>
      <anticipationSoundTicks>-10</anticipationSoundTicks>
      <ticksToImpactRange>-40~-15</ticksToImpactRange>
      <moteSpawnTime>0.05</moteSpawnTime>
      <shadow>Things/Skyfaller/SkyfallerShadowRectangle</shadow>
      <shadowSize>(4.5,6.5)</shadowSize>
      <motesPerCell>1</motesPerCell>
      <rotationCurve>
        <points>
          <li>(0,0)</li>
		  <li>(0.01,2)</li>
          <li>(0.15,2)</li>
          <li>(0.5,-5)</li>
        </points>
      </rotationCurve>
      <zPositionCurve>
        <points>
          <li>(0,0)</li>
		  <li>(0.19,11)</li>
        </points>
      </zPositionCurve>
      <speedCurve>
        <points>
          <li>(0.1,0.2)</li>
		  <li>(0.6,0.7)</li>
        </points>
      </speedCurve>
    </skyfaller>
  </ThingDef>

	<WorldObjectDef ParentName="ShuttleWorldObjectBase">
		<defName>Ship_OverlordShuttle</defName>
		<label>Overlord Dropship</label>
		<description>An Overlord Dropship in flight.</description>
		<expandingIconTexture>World/WorldObjects/Expanding/PassengerShuttle</expandingIconTexture>
		<expandingIconDrawSize>1</expandingIconDrawSize>
	</WorldObjectDef>
  
</Defs>